{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust-wallet",
  "version": "0.1.0",
  "identifier": "io.btechs.rustwallet",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bash ../../scripts/build-web.sh desktop", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rust-wallet",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Lightning wallet over Lightning Labs litd, in Rust",
    "longDescription": "rust-wallet runs Lightning Labs' Lightning Terminal (litd) as a loopback-only sidecar or connects to your own LND/litd node, with a payment engine that never pays twice.",
    "externalBin": ["binaries/litd"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
